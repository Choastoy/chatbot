# ─── Servidor ───────────────────────────────────────────────
PORT=3000
# URL pública (https) onde o sistema está publicado. Usada no link do cardápio.
PUBLIC_URL=https://atendimento.seubar.com.br
# Token de acesso ao painel /admin (use um valor longo e aleatório)
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio
# Arquivo de dados (cardápio, reservas, clientes, conversas)
DATA_FILE=./data/db.json
# Horas sem mensagens até a próxima mensagem abrir uma conversa nova
CONVERSATION_TTL_HOURS=12

# ─── Meta (WhatsApp + Instagram usam o mesmo webhook) ───────
META_WEBHOOK_VERIFY_TOKEN=um_token_aleatorio_para_verificacao
# App secret do app na Meta: valida a assinatura dos webhooks (recomendado)
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Instagram Messaging (conta profissional conectada a uma página do Facebook)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# ─── IA (Anthropic) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modelo e nível de esforço (low é rápido e suficiente para atendimento)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# ─── Equipe ─────────────────────────────────────────────────
# WhatsApp do dono/gerente que recebe leads quentes e pedidos de atendimento humano
OWNER_WHATSAPP_NUMBER=
