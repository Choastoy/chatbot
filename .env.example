# Server
PORT=3000

# WhatsApp Business API (Meta Cloud)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_verify_token

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Calendar
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# Path to the service account JSON key file, or use GOOGLE_SERVICE_ACCOUNT_KEY_JSON
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Owner notification (WhatsApp number to forward qualified leads to)
OWNER_WHATSAPP_NUMBER=5511999999999

# Optional: session TTL in seconds (default 3600 = 1 hour)
SESSION_TTL_SECONDS=3600
